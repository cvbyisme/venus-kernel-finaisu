From: hushangda <noreply@github.com>
Subject: [PATCH 1/3] f2fs: hold node_write when checking NAT entry and validate page mapping

f2fs_is_checkpointed_node() reads the NAT tree without node_write, racing
checkpoint. The fsync-mark retry path also drops the page mapping check, so a
concurrently truncated node page would be dirtied again.

Source: hushangda/android_kernel_xiaomi_sm8350_venus 5d8a2f293d
--- a/fs/f2fs/node.c
+++ b/fs/f2fs/node.c
@@ -414,6 +414,7 @@
 	struct nat_entry *e;
 	bool need_update = true;
 
+	f2fs_down_read(&sbi->node_write);
 	f2fs_down_read(&nm_i->nat_tree_lock);
 	e = __lookup_nat_cache(nm_i, ino);
 	if (e && get_nat_flag(e, HAS_LAST_FSYNC) &&
@@ -421,6 +422,7 @@
 			 get_nat_flag(e, HAS_FSYNCED_INODE)))
 		need_update = false;
 	f2fs_up_read(&nm_i->nat_tree_lock);
+	f2fs_up_read(&sbi->node_write);
 	return need_update;
 }
 
@@ -1845,6 +1847,11 @@
 		f2fs_debug(sbi, "Retry to write fsync mark: ino=%u, idx=%lx",
 			   ino, last_page->index);
 		lock_page(last_page);
+		if (unlikely(last_page->mapping != NODE_MAPPING(sbi))) {
+			f2fs_put_page(last_page, 1);
+			ret = -EAGAIN;
+			goto out;
+		}
 		f2fs_wait_on_page_writeback(last_page, NODE, true, true);
 		set_page_dirty(last_page);
 		unlock_page(last_page);
